# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase (Project Settings -> API Keys): the SECRET key, used only by the local scripts
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# Azure Speech (for STT and TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# ElevenLabs (optional STT provider)
ELEVENLABS_API_KEY=
